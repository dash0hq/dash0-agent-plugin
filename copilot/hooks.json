{
  "version": 1,
  "hooks": {
    "sessionStart":        [{"type": "command", "bash": "${PLUGIN_ROOT}/copilot-on-event.sh sessionStart || true", "timeoutSec": 10}],
    "userPromptSubmitted": [{"type": "command", "bash": "${PLUGIN_ROOT}/copilot-on-event.sh userPromptSubmitted || true", "timeoutSec": 10}],
    "agentStop":           [{"type": "command", "bash": "${PLUGIN_ROOT}/copilot-on-event.sh agentStop || true", "timeoutSec": 10}],
    "sessionEnd":          [{"type": "command", "bash": "${PLUGIN_ROOT}/copilot-on-event.sh sessionEnd || true", "timeoutSec": 10}]
  }
}
