#!/usr/bin/env bash
set -euo pipefail

step() {
  local label=$1
  shift
  printf '\n==> %s\n' "$label"
  time "$@"
}

install_system_packages() {
  local -a packages=()

  command -v curl >/dev/null || packages+=(curl)
  command -v gcc >/dev/null || packages+=(build-essential)
  command -v jq >/dev/null || packages+=(jq)
  command -v make >/dev/null || packages+=(make)
  command -v python3 >/dev/null || packages+=(python3)
  command -v tar >/dev/null || packages+=(tar)
  command -v uuidgen >/dev/null || packages+=(uuid-runtime)
  [ -f /etc/ssl/certs/ca-certificates.crt ] || packages+=(ca-certificates)

  if ((${#packages[@]} == 0)); then
    echo "System packages are already installed."
    return
  fi

  sudo apt-get update
  sudo apt-get install -y --no-install-recommends "${packages[@]}"
  sudo rm -rf /var/lib/apt/lists/*
}

install_go() {
  local version arch checksum archive install_root temp_dir
  version=$(awk '$1 == "go" { print $2; exit }' go.mod)

  case "$(uname -m)" in
    x86_64 | amd64)
      arch=amd64
      checksum=2852af0cb20a13139b3448992e69b868e50ed0f8a1e5940ee1de9e19a123b613
      ;;
    aarch64 | arm64)
      arch=arm64
      checksum=05de75d6994a2783699815ee553bd5a9327d8b79991de36e38b66862782f54ae
      ;;
    *)
      echo "Unsupported architecture: $(uname -m)" >&2
      return 1
      ;;
  esac

  install_root="$HOME/.local/share/go/$version"
  mkdir -p "$HOME/.local/bin" "$(dirname "$install_root")"

  if [ ! -x "$install_root/bin/go" ]; then
    archive="go${version}.linux-${arch}.tar.gz"
    temp_dir=$(mktemp -d)
    trap 'rm -rf "$temp_dir"' RETURN
    curl --fail --location --retry 3 --output "$temp_dir/$archive" \
      "https://go.dev/dl/$archive"
    printf '%s  %s\n' "$checksum" "$temp_dir/$archive" | sha256sum --check -
    mkdir -p "$temp_dir/go-root"
    tar -xzf "$temp_dir/$archive" -C "$temp_dir/go-root" --strip-components=1
    mv "$temp_dir/go-root" "$install_root"
    rm -rf "$temp_dir"
    trap - RETURN
  fi

  ln -sfn "$install_root/bin/go" "$HOME/.local/bin/go"
  ln -sfn "$install_root/bin/gofmt" "$HOME/.local/bin/gofmt"
  go version
}

install_agent_clis() {
  local -a packages=()

  command -v claude >/dev/null || packages+=(@anthropic-ai/claude-code)
  command -v codex >/dev/null || packages+=(@openai/codex)
  command -v copilot >/dev/null || packages+=(@github/copilot)
  if ((${#packages[@]} > 0)); then
    npm install --global "${packages[@]}"
  else
    echo "npm agent CLIs are already installed."
  fi

  if ! command -v cursor-agent >/dev/null; then
    curl --fail --silent --show-error https://cursor.com/install | bash
  else
    echo "Cursor agent CLI is already installed."
  fi
}

install_dash0_cli() {
  local arch release_json tag version archive temp_dir

  if command -v dash0 >/dev/null; then
    echo "Dash0 CLI is already installed."
    return
  fi

  case "$(uname -m)" in
    x86_64 | amd64) arch=amd64 ;;
    aarch64 | arm64) arch=arm64 ;;
    *)
      echo "Unsupported architecture: $(uname -m)" >&2
      return 1
      ;;
  esac

  temp_dir=$(mktemp -d)
  trap 'rm -rf "$temp_dir"' RETURN
  release_json="$temp_dir/release.json"
  curl --fail --location --retry 3 --output "$release_json" \
    https://api.github.com/repos/dash0hq/dash0-cli/releases/latest
  tag=$(jq -r .tag_name "$release_json")
  version=${tag#v}
  archive="dash0_${version}_linux_${arch}.tar.gz"

  curl --fail --location --retry 3 --output "$temp_dir/$archive" \
    "https://github.com/dash0hq/dash0-cli/releases/download/$tag/$archive"
  curl --fail --location --retry 3 --output "$temp_dir/checksums.txt" \
    "https://github.com/dash0hq/dash0-cli/releases/download/$tag/checksums.txt"
  grep -F "  $archive" "$temp_dir/checksums.txt" \
    | (cd "$temp_dir" && sha256sum --check -)
  tar -xzf "$temp_dir/$archive" -C "$temp_dir" dash0
  install -m 0755 "$temp_dir/dash0" "$HOME/.local/bin/dash0"
  rm -rf "$temp_dir"
  trap - RETURN
}

configure_login_shell() {
  local marker="# dash0-agent-plugin orb toolchain"

  if grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
    echo "Login-shell PATH is already configured."
    return
  fi

  cat >>"$HOME/.bash_profile" <<'EOF'

# dash0-agent-plugin orb toolchain
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
EOF
}

step "Install required system packages" install_system_packages
step "Install the Go version from go.mod" install_go
step "Download Go module dependencies" go mod download
step "Install pinned repository lint tools" make golangci-lint-install shellcheck-install
step "Install agent CLIs used by integration and QA flows" install_agent_clis
step "Install the Dash0 CLI used by live QA" install_dash0_cli
step "Expose installed tools to login shells" configure_login_shell

printf '\nOrb setup complete.\n'
