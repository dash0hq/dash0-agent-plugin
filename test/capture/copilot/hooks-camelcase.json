{
  "version": 1,
  "hooks": {
    "sessionStart":        [{"type": "command", "bash": "SET_BY_SETUP_STEP camel", "timeoutSec": 10}],
    "sessionEnd":          [{"type": "command", "bash": "SET_BY_SETUP_STEP camel", "timeoutSec": 10}],
    "userPromptSubmitted": [{"type": "command", "bash": "SET_BY_SETUP_STEP camel", "timeoutSec": 10}],
    "preToolUse":          [{"type": "command", "bash": "SET_BY_SETUP_STEP camel", "timeoutSec": 10}],
    "postToolUse":         [{"type": "command", "bash": "SET_BY_SETUP_STEP camel", "timeoutSec": 10}],
    "postToolUseFailure":  [{"type": "command", "bash": "SET_BY_SETUP_STEP camel", "timeoutSec": 10}],
    "agentStop":           [{"type": "command", "bash": "SET_BY_SETUP_STEP camel", "timeoutSec": 10}],
    "subagentStart":       [{"type": "command", "bash": "SET_BY_SETUP_STEP camel", "timeoutSec": 10}],
    "subagentStop":        [{"type": "command", "bash": "SET_BY_SETUP_STEP camel", "timeoutSec": 10}],
    "errorOccurred":       [{"type": "command", "bash": "SET_BY_SETUP_STEP camel", "timeoutSec": 10}],
